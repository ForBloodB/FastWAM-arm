{
  "mount": "eye_in_hand",
  "mount_confirmed_by_user": true,
  "robot_base_frame": "base_link",
  "robot_tool_frame": "gripper_end",
  "camera_frame": "Gemini305_color_optical",
  "estimated_transform": "T_gripper_camera",
  "runtime_chain": "T_base_camera(q) = T_base_gripper(q) @ T_gripper_camera",
  "target_must_remain_fixed_in_base": true,
  "board_file": "calibration/board.json",
  "minimum_pairs": 15,
  "target_pairs": 20,
  "minimum_independent_rotation_axes": 2,
  "reprojection_rms_max_px": 0.7,
  "held_out_translation_max_m": 0.003,
  "held_out_rotation_max_deg": 1.0,
  "independent_physical_validation_required": true,
  "camera_extrinsic_calibrated": false,
  "motor_execution_enabled": false
}
